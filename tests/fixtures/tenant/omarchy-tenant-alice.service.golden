# Generated by omarchy-tenant 1.0.0 for tenant "alice". Do not edit:
# `omarchy-tenant create alice` re-renders it and the isolation self-check
# reports drift. Policy and threat model: MULTI-TENANT-ISOLATION.md
[Unit]
Description=Omarchy isolated tenant alice
Documentation=man:systemd-nspawn(1) man:systemd.nspawn(5)
Wants=modprobe@tun.service modprobe@loop.service
After=network.target modprobe@tun.service modprobe@loop.service
PartOf=machines.target
Before=machines.target
RequiresMountsFor=@ROOT@/alice

[Service]
Type=notify
ExecStart=/usr/bin/systemd-nspawn --quiet --keep-unit --register=yes --boot --link-journal=no --settings=override --machine=alice --image=@ROOT@/alice/disk.raw
ExecStartPost=/usr/bin/omarchy-tenant _net-up alice
KillMode=mixed
RestartForceExitStatus=133
SuccessExitStatus=133
Slice=machine.slice
Delegate=yes
DelegateSubgroup=supervisor
TasksMax=512
MemoryMax=4G
MemorySwapMax=0
CPUQuota=200%
IOWeight=50
DevicePolicy=closed
DeviceAllow=/dev/net/tun rwm
DeviceAllow=char-pts rw
DeviceAllow=/dev/loop-control rw
DeviceAllow=block-loop rw
DeviceAllow=block-blkext rw
IPAddressDeny=0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.168.0.0/16 198.18.0.0/15 224.0.0.0/4 240.0.0.0/4 ::1/128 fc00::/7 fe80::/10 ff00::/8
RestrictAddressFamilies=~AF_VSOCK
SystemCallFilter=~io_uring_setup io_uring_enter io_uring_register
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
