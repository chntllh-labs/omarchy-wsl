#!/usr/bin/env bash
# ==============================================================================
# /usr/bin/omarchy-build
# Omarchy-WSL cgroup-governed build runner
# ==============================================================================
# Runs a resource-intensive build (cargo, make, cmake, ninja, npm, bun, ...) in
# build.slice of the systemd user manager, with a RAM-safe parallelism:
#
# 1. -j = min(CPUs, RAM GiB / 2), at least 2, exported as CARGO_BUILD_JOBS,
#    MAKEFLAGS and CMAKE_BUILD_PARALLEL_LEVEL (an explicit -j always wins).
# 2. omarchy-power-governor scales the computed -j on battery / Energy Saver /
#    thermal limits (never an explicit -j).
# 3. `systemd-run --user --scope --slice=build.slice` places the build in a
#    transient scope: CPUWeight/IOWeight below interactive work, OOMPolicy=kill
#    (the kernel kills the whole build together instead of one rustc at a time;
#    systemd sets memory.oom.group). A scope (not a service) keeps the caller's
#    full environment (PATH, CC, RUSTFLAGS, the -j variables), terminal, signals
#    and exit status, and needs no user D-Bus session.
# 4. The build's oom_score_adj is raised to 500 so the kernel OOM killer picks
#    it before shells and editors (raising needs no privilege).
# 5. Builds on Windows drives (DrvFs over 9p or virtiofs) are refused.
# Without a reachable user manager the same limits are applied directly
# (nice 10, oom_score_adj 500).
# ==============================================================================

set -euo pipefail

_self="$(readlink -f "${BASH_SOURCE[0]}")"
for _lib in "${OMARCHY_WSL_LIB:-}" "${_self%/*}/../lib/omarchy-wsl-interop.sh" /usr/lib/omarchy-wsl/interop.sh; do
  # shellcheck source=SCRIPTDIR/../lib/omarchy-wsl-interop.sh
  [[ -n "$_lib" && -r "$_lib" ]] && { source "$_lib"; break; }
done
declare -F omw_is_drvfs >/dev/null || { echo "omarchy-build: interop library not found" >&2; exit 1; }
OMW_TAG="omarchy-build"

usage() {
  cat <<'EOF'
Usage: omarchy-build [options] [--] <command> [args...]

Options:
  -j, --jobs <N>       Maximum parallel jobs (default: min(CPUs, RAM GiB / 2))
  --slice <name>       systemd user slice (default: build.slice)
  --no-cgroup          Skip systemd; apply nice 10 + oom_score_adj 500 directly
  --no-power           Ignore battery/thermal state (skip omarchy-power-governor)
  --notify             Raise a Windows toast when the build finishes (omarchy-notify)
  --allow-drvfs        Permit building inside a Windows drive (/mnt/<drive>)
  --dry-run            Print the computed parallelism and the exact command, then exit
  -h, --help           Show this help

Exit status: the command's own status; 2 usage error; 3 refused (Windows drive).

Examples:
  omarchy-build cargo build --release
  omarchy-build -j 4 make
  omarchy-build --notify npm run build
EOF
}

CUSTOM_JOBS=""
TARGET_SLICE="build.slice"
BYPASS_CGROUP=0
NO_POWER=0
NOTIFY=0
ALLOW_DRVFS=0
DRY_RUN=0
SELF_DIR="$(dirname "$_self")"

usage_error() {
  omw_err "$*"
  usage >&2
  exit 2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -j|--jobs)
      [[ $# -ge 2 ]] || usage_error "$1 requires a value"
      CUSTOM_JOBS="$2"
      shift 2
      ;;
    -j[0-9]*) CUSTOM_JOBS="${1#-j}"; shift ;;
    --jobs=*) CUSTOM_JOBS="${1#*=}"; shift ;;
    --slice)
      [[ $# -ge 2 ]] || usage_error "--slice requires a value"
      TARGET_SLICE="$2"
      shift 2
      ;;
    --slice=*) TARGET_SLICE="${1#*=}"; shift ;;
    --no-cgroup) BYPASS_CGROUP=1; shift ;;
    --no-power) NO_POWER=1; shift ;;
    --notify) NOTIFY=1; shift ;;
    --allow-drvfs) ALLOW_DRVFS=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -*) usage_error "Unknown option: $1" ;;
    *) break ;;
  esac
done

[[ $# -gt 0 ]] || usage_error "No command given."
if [[ -n "$CUSTOM_JOBS" ]] && ! [[ "$CUSTOM_JOBS" =~ ^[1-9][0-9]{0,3}$ ]]; then
  usage_error "--jobs expects a positive integer, got '$CUSTOM_JOBS'"
fi
[[ "$TARGET_SLICE" =~ ^[A-Za-z0-9:_.-]+\.slice$ ]] || usage_error "Invalid slice name '$TARGET_SLICE'"
BUILD_NAME="${1##*/}"

# -----------------------------------------------------------------------------
# 1. DrvFs boundary: builds on /mnt/<drive> are slow and break file watchers.
#    omw_is_drvfs recognises 9p, drvfs and virtiofs-backed Windows drives.
# -----------------------------------------------------------------------------
if (( ALLOW_DRVFS == 0 )) && [[ "${OMARCHY_DRVFS_GUARD:-block}" != "off" ]] && omw_is_drvfs "$PWD"; then
  if [[ "${OMARCHY_DRVFS_GUARD:-block}" == "warn" ]]; then
    omw_warn "Building on a Windows drive ($PWD) is slow; prefer ~/src (ext4)."
  else
    omw_err "Refusing to build on a Windows drive ($PWD)."
    omw_err "Move the project to ~/src (ext4), or pass --allow-drvfs."
    exit 3
  fi
fi

# -----------------------------------------------------------------------------
# 2. Safe parallelism (-j) from RAM and cores
# -----------------------------------------------------------------------------
# Compilers and linkers (rustc, clang++, lld) use up to ~2 GiB per job; an
# unconstrained -j on a high-core, low-RAM machine OOMs while linking.
TOTAL_CPUS=$(nproc 2>/dev/null || echo 2)
MEM_KB=$(awk '/MemTotal/ {print $2}' /proc/meminfo 2>/dev/null || echo 8388608)
MAX_SAFE_BY_RAM=$(( MEM_KB / 1024 / 1024 / 2 ))
(( MAX_SAFE_BY_RAM < 2 )) && MAX_SAFE_BY_RAM=2

if [[ -n "$CUSTOM_JOBS" ]]; then
  JOBS="$CUSTOM_JOBS"
elif (( TOTAL_CPUS < MAX_SAFE_BY_RAM )); then
  JOBS="$TOTAL_CPUS"
else
  JOBS="$MAX_SAFE_BY_RAM"
fi

# Sibling tools first (repo checkout), then PATH (installed system).
find_tool() {
  if [[ -x "${SELF_DIR}/$1" ]]; then
    echo "${SELF_DIR}/$1"
  else
    command -v "$1" 2>/dev/null
  fi
}

# Power & thermal governance: only the computed default is governed.
POWER_NOTE=""
if [[ -z "$CUSTOM_JOBS" && $NO_POWER -eq 0 && "${OMARCHY_POWER_GOVERNOR:-auto}" != "off" ]]; then
  if GOVERNOR=$(find_tool omarchy-power-governor); then
    GOVERNED=$(timeout 10 "$GOVERNOR" jobs "$JOBS" 2>/dev/null || true)
    if [[ "$GOVERNED" =~ ^[0-9]+$ ]] && (( GOVERNED >= 1 && GOVERNED < JOBS )); then
      POWER_NOTE="power governor: -j${JOBS} -> -j${GOVERNED}"
      JOBS="$GOVERNED"
    fi
  fi
fi

if (( NOTIFY == 1 )); then
  if NOTIFIER=$(find_tool omarchy-notify); then
    set -- "$NOTIFIER" --wrap --min-seconds "${OMARCHY_NOTIFY_MIN_SECONDS:-0}" -- "$@"
  else
    omw_warn "--notify requested but omarchy-notify is not installed."
  fi
fi

export CARGO_BUILD_JOBS="$JOBS"
export MAKEFLAGS="-j$JOBS"
export CMAKE_BUILD_PARALLEL_LEVEL="$JOBS"
export NINJA_STATUS="${NINJA_STATUS:-[%f/%t %s] }"

# -----------------------------------------------------------------------------
# 3. Execution engine
# -----------------------------------------------------------------------------
# Transient scope properties. Every name is valid for a scope unit on
# systemd >= 253 (tests/test_build_governance.sh cross-checks the list with
# systemd-analyze). OOMScoreAdjust is an exec setting and is NOT accepted on a
# scope, so the score is raised on this process before exec instead.
SCOPE_PROPERTIES=(
  "CPUWeight=${OMARCHY_BUILD_CPU_WEIGHT:-20}"
  "IOWeight=${OMARCHY_BUILD_IO_WEIGHT:-20}"
  "OOMPolicy=kill"
)

user_manager_ok() {
  [[ -n "${OMARCHY_BUILD_FORCE_SYSTEMD:-}" ]] && return 0
  [[ -d /run/systemd/system ]] || return 1
  omw_have systemd-run || return 1
  systemctl --user is-active basic.target >/dev/null 2>&1
}

ENGINE="direct"
if (( BYPASS_CGROUP == 0 )) && user_manager_ok; then
  ENGINE="systemd"
fi

RUN=()
if [[ "$ENGINE" == "systemd" ]]; then
  RUN=(systemd-run --user --scope --quiet --collect "--slice=${TARGET_SLICE}"
       "--description=omarchy-build: ${BUILD_NAME}")
  for _p in "${SCOPE_PROPERTIES[@]}"; do
    RUN+=("--property=${_p}")
  done
  RUN+=(--)
fi

[[ -n "$POWER_NOTE" && -t 2 ]] && omw_log "${POWER_NOTE}"

if (( DRY_RUN == 1 )); then
  echo "jobs=${JOBS}"
  [[ -n "$POWER_NOTE" ]] && echo "note=${POWER_NOTE}"
  echo "engine=${ENGINE}"
  printf 'command='
  printf '%q ' "${RUN[@]}" "$@"
  printf '\n'
  exit 0
fi

# Raise our own OOM score (inherited by the build); lowering would need root.
echo 500 >"/proc/$$/oom_score_adj" 2>/dev/null || true

if [[ "$ENGINE" == "systemd" ]]; then
  exec "${RUN[@]}" "$@"
fi

# Fallback without a user manager: lower CPU priority directly.
renice -n 10 -p $$ >/dev/null 2>&1 || true
exec "$@"
