#!/usr/bin/env bash
# ==============================================================================
# Omarchy WSL: resolv.conf Health Check & Repair
# /usr/bin/omarchy-dns-sync
# ==============================================================================
# Resolver model (Omarchy-WSL): systemd-resolved is masked and WSL generates
# /etc/resolv.conf at every start (wsl.conf: generateResolvConf = true). With
# DNS tunneling that file points at WSL's DNS proxy (10.255.255.254), in NAT
# mode at the NAT gateway; both follow VPN changes on the Windows side. This
# tool therefore never rewrites a healthy file:
#
#   sync (default)  resolv.conf has a valid nameserver -> remember it as the
#                   last-known-good upstream set and change nothing. Missing,
#                   empty or invalid -> write a direct resolv.conf from, in
#                   order: last-known-good, Windows DNS servers (bounded
#                   PowerShell probe), the default gateway.
#   direct          write a direct resolv.conf from the same sources (explicit).
#   check|status    report; change nothing.
#
# Public resolvers are never added unless --public-fallback is given (they
# break split-horizon/internal names and leak queries past a VPN). No
# `options rotate`. A symlinked /etc/resolv.conf (an opt-in resolver such as
# systemd-resolved) is left alone. Every nameserver is validated as an IPv4 or
# IPv6 literal and every search domain as a DNS name; state files are parsed,
# never sourced.
#
# Exit status: 0 healthy or repaired; 1 broken and not repairable; 2 usage.
# ==============================================================================

set -euo pipefail

_self="$(readlink -f "${BASH_SOURCE[0]}")"
for _lib in "${OMARCHY_WSL_LIB:-}" "${_self%/*}/../lib/omarchy-wsl-interop.sh" /usr/lib/omarchy-wsl/interop.sh; do
  # shellcheck source=SCRIPTDIR/../lib/omarchy-wsl-interop.sh
  [[ -n "$_lib" && -r "$_lib" ]] && { source "$_lib"; break; }
done
declare -F omw_ps_run >/dev/null || { echo "omarchy-dns-sync: interop library not found" >&2; exit 1; }
OMW_TAG="omarchy-dns-sync"

RESOLV_CONF="${OMARCHY_RESOLV_CONF:-/etc/resolv.conf}"
RUN_DIR="${OMARCHY_DNS_RUN_DIR:-/run/omarchy}"
STATE_FILE="${RUN_DIR}/wsl-upstream-dns.conf"
PERSIST_FILE="${OMARCHY_DNS_PERSIST_FILE:-/etc/omarchy/wsl-upstream-dns.conf}"
PUBLIC_RESOLVERS=(1.1.1.1 9.9.9.9)
MAX_NS=3        # glibc uses at most three nameservers (MAXNS)
MAX_SEARCH=6

usage() {
  cat <<'EOF'
Usage: omarchy-dns-sync [sync|direct|check|status] [options]

  sync              keep a healthy WSL resolv.conf; repair a broken one (default)
  direct            write a direct resolv.conf from the discovered upstreams
  check, status     report only

Options:
  --public-fallback also append public resolvers (1.1.1.1, 9.9.9.9) when
                    writing; never the default
  --force           direct: replace a symlinked resolv.conf
  --dry-run         print what would be written; change nothing
  -q, --quiet       only warnings and errors
  -h, --help        show this help
EOF
}

CMD="sync"
PUBLIC_FALLBACK=0
FORCE=0
DRY_RUN=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    sync|direct|check|status) CMD="$1"; shift ;;
    --public-fallback) PUBLIC_FALLBACK=1; shift ;;
    --force) FORCE=1; shift ;;
    --dry-run|-n) DRY_RUN=1; shift ;;
    -q|--quiet) OMW_QUIET=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) omw_err "Unknown argument: $1"; usage >&2; exit 2 ;;
  esac
done

# -----------------------------------------------------------------------------
# Validation
# -----------------------------------------------------------------------------
is_ipv4() {
  local o
  [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  for o in "${BASH_REMATCH[@]:1}"; do
    # glibc parses a leading zero as octal: reject "010".
    [[ "$o" == 0 || "$o" != 0* ]] || return 1
    (( 10#$o <= 255 )) || return 1
  done
}

is_ipv6() {
  local a="$1" g n=0
  local -a groups=()
  [[ "$a" =~ ^[0-9A-Fa-f:.]{2,45}$ && "$a" == *:* ]] || return 1
  if [[ "$a" == *.* ]]; then
    is_ipv4 "${a##*:}" || return 1
    a="${a%:*}:0:0"            # an embedded IPv4 counts as two groups
  fi
  case "$a" in
    *::*::*|*:::*) return 1 ;;
  esac
  if [[ "$a" == *::* ]]; then
    [[ "${a%%::*}" != :* && "${a#*::}" != *: ]] || return 1
    IFS=: read -r -a groups <<<"${a%%::*}:${a#*::}"
    for g in "${groups[@]}"; do
      [[ -z "$g" ]] && continue
      [[ "$g" =~ ^[0-9A-Fa-f]{1,4}$ ]] || return 1
      n=$((n + 1))
    done
    (( n <= 7 ))
  else
    [[ "$a" != :* && "$a" != *: ]] || return 1
    IFS=: read -r -a groups <<<"$a"
    for g in "${groups[@]}"; do
      [[ "$g" =~ ^[0-9A-Fa-f]{1,4}$ ]] || return 1
      n=$((n + 1))
    done
    (( n == 8 ))
  fi
}

# A usable nameserver: an IP literal; IPv6 link-local / Windows zone ids and
# the deprecated fec0::/10 site-local placeholders Windows lists are refused.
valid_ns() {
  local a="$1"
  [[ "$a" == 0.0.0.0 || "$a" == :: ]] && return 1   # unspecified address
  is_ipv4 "$a" && return 0
  [[ "$a" == *%* ]] && return 1
  is_ipv6 "$a" || return 1
  [[ "${a,,}" =~ ^fe[89ab][0-9a-f]: || "${a,,}" =~ ^fe[c-f][0-9a-f]: ]] && return 1
  return 0
}

is_loopback() { [[ "$1" == 127.* || "$1" == ::1 ]]; }

valid_domain() {
  local d="${1%.}"
  (( ${#d} >= 1 && ${#d} <= 253 )) || return 1
  [[ "$d" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$ ]]
}

# -----------------------------------------------------------------------------
# Readers (resolv.conf syntax; never sourced). Fill the named arrays.
# -----------------------------------------------------------------------------
NS=()
SEARCH=()
add_ns() {
  local a="$1" x
  valid_ns "$a" || return 0
  for x in "${NS[@]+"${NS[@]}"}"; do [[ "$x" == "$a" ]] && return 0; done
  NS+=("$a")
}
add_search() {
  local d="${1%.}" x
  valid_domain "$d" || return 0
  for x in "${SEARCH[@]+"${SEARCH[@]}"}"; do [[ "$x" == "$d" ]] && return 0; done
  (( ${#SEARCH[@]} < MAX_SEARCH )) && SEARCH+=("$d")
  return 0
}

# read_resolv <file> [--no-loopback]
read_resolv() {
  local file="$1" no_lo="${2:-}" key rest tok
  [[ -r "$file" ]] || return 1
  while read -r key rest; do
    case "$key" in
      nameserver)
        tok="${rest%%[[:space:]]*}"
        [[ -n "$no_lo" ]] && is_loopback "$tok" && continue
        add_ns "$tok"
        ;;
      search|domain)
        for tok in $rest; do add_search "$tok"; done
        ;;
    esac
  done <"$file"
}

# -----------------------------------------------------------------------------
# Discovery
# -----------------------------------------------------------------------------
read -r -d '' DNS_QUERY <<'PS' || true
$seen = @{}
foreach ($i in @(Get-DnsClientServerAddress -ErrorAction Stop)) {
  foreach ($a in @($i.ServerAddresses)) { if ($a -and -not $seen.ContainsKey($a)) { $seen[$a] = 1; [Console]::Out.WriteLine('NS ' + $a) } }
}
try { foreach ($d in @((Get-DnsClientGlobalSetting -ErrorAction Stop).SuffixSearchList)) { if ($d) { [Console]::Out.WriteLine('SEARCH ' + $d) } } } catch {}
try { foreach ($c in @(Get-DnsClient -ErrorAction Stop)) { if ($c.ConnectionSpecificSuffix) { [Console]::Out.WriteLine('SEARCH ' + $c.ConnectionSpecificSuffix) } } } catch {}
[Console]::Out.WriteLine('END')
PS

discover_windows() {
  local raw kind val got=0
  omw_is_wsl && omw_interop_enabled || return 1
  raw=$(OMW_TIMEOUT="${OMARCHY_DNS_PS_TIMEOUT:-6}" omw_ps_run "$DNS_QUERY") || return 1
  [[ "$raw" == *END* ]] || return 1
  while read -r kind val; do
    case "$kind" in
      NS) valid_ns "$val" && { add_ns "$val"; got=1; } ;;
      SEARCH) add_search "$val" ;;
    esac
  done <<<"$raw"
  (( got ))
}

discover_gateway() {
  local gw
  gw=$(ip -4 route show default 2>/dev/null | awk '/^default/ { print $3; exit }') || true
  [[ -n "$gw" ]] && valid_ns "$gw" && add_ns "$gw"
  [[ -n "$gw" ]]
}

# discover: fills NS/SEARCH for a direct file (current valid file first).
discover() {
  NS=()
  SEARCH=()
  [[ -L "$RESOLV_CONF" ]] || read_resolv "$RESOLV_CONF" --no-loopback || true
  if (( ${#NS[@]} == 0 )); then
    read_resolv "$STATE_FILE" || true
    (( ${#NS[@]} )) || read_resolv "$PERSIST_FILE" || true
  fi
  if (( ${#NS[@]} == 0 )); then
    discover_windows || omw_warn "Windows DNS probe failed or timed out."
  fi
  (( ${#NS[@]} )) || discover_gateway || true
}

# -----------------------------------------------------------------------------
# Writers
# -----------------------------------------------------------------------------
atomic_write() {  # <dest> <mode>; content on stdin
  local dest="$1" mode="$2" tmp
  mkdir -p -- "$(dirname "$dest")"
  tmp=$(mktemp "${dest}.omarchy.XXXXXX")
  cat >"$tmp"
  chmod "$mode" "$tmp"
  mv -f -- "$tmp" "$dest"
}

render_state() {
  local n d
  echo "# omarchy-dns-sync last-known-good upstreams (parsed, never sourced)"
  for n in "${NS[@]}"; do echo "nameserver $n"; done
  for d in "${SEARCH[@]+"${SEARCH[@]}"}"; do echo "search $d"; done
}

render_resolv() {
  local n count=0 p
  echo "# Managed by omarchy-dns-sync (direct mode). WSL regenerates this file at the"
  echo "# next start while wsl.conf has generateResolvConf = true."
  (( ${#SEARCH[@]} )) && echo "search ${SEARCH[*]}"
  for n in "${NS[@]}"; do
    (( count < MAX_NS )) || break
    echo "nameserver $n"
    count=$((count + 1))
  done
  if (( PUBLIC_FALLBACK )); then
    for p in "${PUBLIC_RESOLVERS[@]}"; do
      (( count < MAX_NS )) || break
      [[ " ${NS[*]} " == *" $p "* ]] && continue
      echo "nameserver $p"
      count=$((count + 1))
    done
  fi
  echo "options timeout:2 attempts:2"
}

save_state() {
  (( ${#NS[@]} )) || return 0
  (( DRY_RUN )) && return 0
  render_state | atomic_write "$STATE_FILE" 0644 2>/dev/null || true
  render_state | atomic_write "$PERSIST_FILE" 0644 2>/dev/null || true
}

write_direct() {
  if (( ${#NS[@]} == 0 )) && (( PUBLIC_FALLBACK )); then
    omw_warn "No upstream DNS discovered; using public resolvers (--public-fallback)."
  fi
  if (( ${#NS[@]} == 0 && ! PUBLIC_FALLBACK )); then
    omw_err "No upstream DNS discovered (last-known-good, Windows, gateway). Not writing an empty resolv.conf; re-run with --public-fallback to use public resolvers."
    return 1
  fi
  if (( DRY_RUN )); then
    echo "== $RESOLV_CONF"
    render_resolv
    return 0
  fi
  render_resolv | atomic_write "$RESOLV_CONF" 0644
  omw_log "Wrote direct $RESOLV_CONF (nameservers: ${NS[*]:-public fallback})."
}

# -----------------------------------------------------------------------------
# Commands
# -----------------------------------------------------------------------------
cmd_sync() {
  if [[ -L "$RESOLV_CONF" ]]; then
    omw_log "$RESOLV_CONF is a symlink to $(readlink "$RESOLV_CONF") (an opt-in resolver); leaving it alone."
    return 0
  fi
  NS=()
  SEARCH=()
  read_resolv "$RESOLV_CONF" || true
  if (( ${#NS[@]} )); then
    save_state
    omw_log "$RESOLV_CONF is healthy (nameservers: ${NS[*]}); unchanged."
    return 0
  fi
  omw_warn "$RESOLV_CONF is missing or has no valid nameserver; repairing."
  discover
  write_direct && save_state
}

cmd_direct() {
  if [[ -L "$RESOLV_CONF" ]] && (( ! FORCE )); then
    omw_err "$RESOLV_CONF is a symlink to $(readlink "$RESOLV_CONF"); pass --force to replace it."
    return 1
  fi
  discover
  write_direct && save_state
}

cmd_status() {
  echo "resolv.conf:  $RESOLV_CONF -> $(readlink -f "$RESOLV_CONF" 2>/dev/null || echo "$RESOLV_CONF")"
  if [[ -r "$RESOLV_CONF" ]]; then
    grep -qi 'generated by WSL' "$RESOLV_CONF" && echo "generator:    WSL (generateResolvConf = true)"
    grep -q '^# Managed by omarchy-dns-sync' "$RESOLV_CONF" && echo "generator:    omarchy-dns-sync (direct)"
  fi
  NS=(); SEARCH=()
  read_resolv "$RESOLV_CONF" || true
  echo "nameservers:  ${NS[*]:-<none valid>}"
  echo "search:       ${SEARCH[*]:-<none>}"
  NS=(); SEARCH=()
  read_resolv "$PERSIST_FILE" || true
  echo "last good:    ${NS[*]:-<none>}"
  if timeout 5 getent ahosts archlinux.org >/dev/null 2>&1; then
    echo "resolution:   ok (archlinux.org)"
  else
    echo "resolution:   FAILED (archlinux.org)"
    return 1
  fi
}

case "$CMD" in
  sync) cmd_sync ;;
  direct) cmd_direct ;;
  check|status) cmd_status ;;
esac
