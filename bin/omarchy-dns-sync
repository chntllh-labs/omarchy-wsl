#!/usr/bin/env bash
# ==============================================================================
# Omarchy WSL: Dynamic DNS & Resolver Synchronization Engine
# /usr/bin/omarchy-dns-sync
# ==============================================================================
# Harmonizes WSL 2 / WSL 3.0.1 DNS tunneling, NAT gateways, and systemd-resolved.
# Prevents DNS breakage across corporate VPN transitions, Zscaler, and host reboots.
# ==============================================================================

set -euo pipefail

RUN_DIR="/run/omarchy"
STATE_FILE="${RUN_DIR}/wsl-upstream-dns.conf"
PERSIST_FILE="/etc/omarchy/wsl-upstream-dns.conf"
RESOLV_CONF="/etc/resolv.conf"
STUB_RESOLV="/run/systemd/resolve/stub-resolv.conf"

mkdir -p "$RUN_DIR" "$(dirname "$PERSIST_FILE")"

log() { echo -e "\e[32m[omarchy-dns-sync]\e[0m $*"; }
warn() { echo -e "\e[33m[omarchy-dns-sync:WARN]\e[0m $*"; }
err() { echo -e "\e[31m[omarchy-dns-sync:ERROR]\e[0m $*"; }

# -----------------------------------------------------------------------------
# 1. Discover Authoritative WSL Upstream DNS
# -----------------------------------------------------------------------------
discover_upstream_dns() {
  local nameservers=()
  local search_domains=()

  # Strategy A: Check existing /etc/resolv.conf if generated by WSL
  if [[ -f "$RESOLV_CONF" && ! -L "$RESOLV_CONF" ]]; then
    if grep -qi "automatically generated by WSL" "$RESOLV_CONF" 2>/dev/null; then
      while read -r line; do
        if [[ "$line" =~ ^nameserver[[:space:]]+([^[:space:]]+) ]]; then
          local ns="${BASH_REMATCH[1]}"
          # Avoid self-referential loopback if stub resolver was somehow written
          if [[ "$ns" != "127.0.0.53" ]]; then
            nameservers+=("$ns")
          fi
        elif [[ "$line" =~ ^search[[:space:]]+(.+) ]]; then
          search_domains+=("${BASH_REMATCH[1]}")
        fi
      done < "$RESOLV_CONF"
    fi
  fi

  # Strategy B: Check cached state from earlier in this boot
  if [[ ${#nameservers[@]} -eq 0 && -f "$STATE_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$STATE_FILE"
  fi

  # Strategy C: Check persisted state from previous boot
  if [[ ${#nameservers[@]} -eq 0 && -f "$PERSIST_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$PERSIST_FILE"
  fi

  # Strategy D: Check default gateway on eth0 (common in NAT mode)
  if [[ ${#nameservers[@]} -eq 0 ]]; then
    local default_gw
    default_gw=$(ip route show default 2>/dev/null | awk '/default/ {print $3}' | head -n 1 || true)
    if [[ -n "$default_gw" ]]; then
      nameservers+=("$default_gw")
    fi
  fi

  # Strategy E: Interop query to Windows Host PowerShell (if /mnt/c is mounted)
  if [[ ${#nameservers[@]} -eq 0 && -x "/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe" ]]; then
    local ps_dns
    ps_dns=$(/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -NonInteractive -Command \
      "(Get-DnsClientServerAddress -AddressFamily IPv4 | Where-Object { \$_.ServerAddresses.Count -gt 0 } | Select-Object -ExpandProperty ServerAddresses) -join ' '" 2>/dev/null | tr -d '\r' || true)
    for ns in $ps_dns; do
      [[ -n "$ns" ]] && nameservers+=("$ns")
    done
  fi

  # Strategy F: Hardcoded resilient anycast fallbacks
  if [[ ${#nameservers[@]} -eq 0 ]]; then
    warn "No WSL host DNS detected! Falling back to resilient public anycast resolvers."
    nameservers=("1.1.1.1" "8.8.8.8" "9.9.9.9")
  fi

  # Deduplicate nameservers
  local unique_ns=()
  for ns in "${nameservers[@]}"; do
    if [[ ! " ${unique_ns[*]} " =~ " ${ns} " ]]; then
      unique_ns+=("$ns")
    fi
  done

  # Save to run state
  {
    echo "nameservers=(${unique_ns[*]})"
    echo "search_domains=(${search_domains[*]:-})"
  } > "$STATE_FILE"
  cp "$STATE_FILE" "$PERSIST_FILE"

  echo "${unique_ns[*]}"
}

# -----------------------------------------------------------------------------
# 2. Configure systemd-resolved and Verify Health
# -----------------------------------------------------------------------------
sync_resolved() {
  local upstream_ns="$1"
  local resolved_active=0

  if command -v systemctl >/dev/null 2>&1; then
    if systemctl is-active --quiet systemd-resolved 2>/dev/null; then
      resolved_active=1
    fi
  fi

  if [[ $resolved_active -eq 1 ]] && command -v resolvectl >/dev/null 2>&1; then
    # Find primary interface (usually eth0)
    local iface
    iface=$(ip -o -4 route show to default 2>/dev/null | awk '{print $5}' | head -n 1 || true)
    [[ -z "$iface" ]] && iface="eth0"

    log "Configuring systemd-resolved uplink on $iface with: $upstream_ns"
    # shellcheck disable=SC2086
    resolvectl dns "$iface" $upstream_ns 2>/dev/null || true
    resolvectl domain "$iface" "~." 2>/dev/null || true
    resolvectl default-route "$iface" yes 2>/dev/null || true

    # Test resolution via local stub resolver (127.0.0.53)
    local test_success=0
    if command -v getent >/dev/null 2>&1; then
      if getent ahostsv4 archlinux.org >/dev/null 2>&1 || getent ahostsv4 microsoft.com >/dev/null 2>&1; then
        test_success=1
      fi
    fi

    if [[ $test_success -eq 1 ]]; then
      log "systemd-resolved is active and resolving successfully."
      # Safely link /etc/resolv.conf -> stub-resolv.conf
      if [[ ! -L "$RESOLV_CONF" || "$(readlink "$RESOLV_CONF")" != "$STUB_RESOLV" ]]; then
        ln -sf "$STUB_RESOLV" "${RESOLV_CONF}.tmp"
        mv -f "${RESOLV_CONF}.tmp" "$RESOLV_CONF"
      fi
      return 0
    else
      warn "systemd-resolved active but test query failed; falling back to direct nameserver mode."
    fi
  fi

  # Fallback: Write direct /etc/resolv.conf pointing to upstream nameservers
  write_direct_resolv "$upstream_ns"
}

write_direct_resolv() {
  local upstream_ns="$1"
  log "Writing direct resilient /etc/resolv.conf..."

  local tmp_file="${RESOLV_CONF}.tmp.$$"
  {
    echo "# Managed by Omarchy WSL DNS Engine (Resilient Direct Fallback)"
    echo "# Generated: $(date -u +'%Y-%m-%dT%H:%M:%SZ')"
    echo "options timeout:2 attempts:3 rotate"
    for ns in $upstream_ns; do
      echo "nameserver $ns"
    done
    # Append public fallbacks
    echo "nameserver 1.1.1.1"
    echo "nameserver 8.8.8.8"
  } > "$tmp_file"

  mv -f "$tmp_file" "$RESOLV_CONF"
}

# -----------------------------------------------------------------------------
# Main Execution
# -----------------------------------------------------------------------------
case "${1:-sync}" in
  sync)
    UPSTREAM=$(discover_upstream_dns)
    sync_resolved "$UPSTREAM"
    ;;
  check|status)
    echo "=== Omarchy WSL DNS Status ==="
    echo "Current /etc/resolv.conf target: $(readlink -f "$RESOLV_CONF" 2>/dev/null || echo "$RESOLV_CONF")"
    if [[ -f "$RESOLV_CONF" ]]; then
      cat "$RESOLV_CONF"
    fi
    echo "--- Upstream State Cache ---"
    if [[ -f "$STATE_FILE" ]]; then
      cat "$STATE_FILE"
    fi
    echo "--- System Resolution Test ---"
    if getent ahostsv4 archlinux.org >/dev/null 2>&1; then
      echo -e "\e[32m[PASS]\e[0m Successfully resolved archlinux.org"
    else
      echo -e "\e[31m[FAIL]\e[0m Failed to resolve archlinux.org"
    fi
    ;;
  direct)
    UPSTREAM=$(discover_upstream_dns)
    write_direct_resolv "$UPSTREAM"
    ;;
  *)
    echo "Usage: $(basename "$0") [sync|check|status|direct]"
    exit 1
    ;;
esac
