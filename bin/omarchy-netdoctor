#!/usr/bin/env bash
# ==============================================================================
# Omarchy WSL: Network Diagnostics
# /usr/bin/omarchy-netdoctor
# ==============================================================================
# Audits WSL networking (mode, sysctls), DNS (resolv.conf model, resolution),
# proxy/TLS trust, pacman configuration and mirrors, container engine configs
# and the Windows interop shims. `--repair` runs the sync tools
# (omarchy-dns-sync, omarchy-ca-sync, omarchy-proxy-sync, omarchy-mirror-sync;
# they need root) and audits again.
#
# Counting: PASS / WARN / FAIL lines are checks; INFO lines are context and are
# never counted as passed. Exit status: 0 no FAIL, 1 at least one FAIL,
# 2 usage.
#
# Test seams: OMARCHY_NETDOCTOR_ROOT (prefix for every file path read), and
# PATH for the commands used (ip, sysctl, getent, curl, ping, systemctl,
# wslinfo, the omarchy-*-sync tools).
# ==============================================================================

set -euo pipefail

R="${OMARCHY_NETDOCTOR_ROOT:-}"
SELF_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  C_RESET=$'\e[0m' C_GREEN=$'\e[32m' C_YELLOW=$'\e[33m' C_RED=$'\e[31m' C_CYAN=$'\e[36m' C_BOLD=$'\e[1m'
else
  C_RESET="" C_GREEN="" C_YELLOW="" C_RED="" C_CYAN="" C_BOLD=""
fi

N_PASS=0
N_WARN=0
N_FAIL=0
record_pass() { N_PASS=$((N_PASS + 1)); printf '  [%sPASS%s] %s\n' "$C_GREEN" "$C_RESET" "$*"; }
record_warn() { N_WARN=$((N_WARN + 1)); printf '  [%sWARN%s] %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
record_fail() { N_FAIL=$((N_FAIL + 1)); printf '  [%sFAIL%s] %s\n' "$C_RED" "$C_RESET" "$*"; }
info() { printf '  [%sINFO%s] %s\n' "$C_CYAN" "$C_RESET" "$*"; }
header() { printf '\n%s%s=== %s ===%s\n' "$C_BOLD" "$C_CYAN" "$*" "$C_RESET"; }
log() { printf '%s[omarchy-netdoctor]%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

# count_matches <regex> <file>: number of matching lines (0 when none/missing).
count_matches() {
  local n
  n=$(grep -cE -- "$1" "$2" 2>/dev/null) || true
  echo "${n:-0}"
}

sysctl_value() {
  local v
  v=$(sysctl -n "$1" 2>/dev/null) || return 1
  [[ -n "$v" ]] || return 1
  echo "$v"
}

# -----------------------------------------------------------------------------
# 1. WSL networking
# -----------------------------------------------------------------------------
audit_wsl_mode() {
  header "1. WSL networking"
  if [[ -e "$R/proc/sys/fs/binfmt_misc/WSLInterop" || -e "$R/proc/sys/fs/binfmt_misc/WSLInterop-late" || -d "$R/run/WSL" ]]; then
    record_pass "Running under WSL (interop registered)."
  else
    record_warn "WSL interop not detected (plain Linux host, container, or interop disabled)."
  fi

  local mode=""
  if have wslinfo; then
    mode=$(wslinfo --networking-mode 2>/dev/null || true)
  fi
  if [[ -n "$mode" ]]; then
    info "Networking mode: $mode (wslinfo)."
  elif ip -4 addr show 2>/dev/null | grep -q '10\.255\.255\.254'; then
    info "DNS tunneling address 10.255.255.254 present (dnsTunneling=true)."
  else
    info "Networking mode unknown (no wslinfo); see .wslconfig networkingMode."
  fi

  local port
  if port=$(sysctl_value net.ipv4.ip_unprivileged_port_start); then
    if (( port == 0 )); then
      record_warn "net.ipv4.ip_unprivileged_port_start = 0: any local user can bind privileged ports (22, 53, 443)."
    elif (( port < 1024 )); then
      info "Unprivileged ports start at $port (lowered from 1024 by a local sysctl)."
    else
      record_pass "Privileged ports (< $port) need root or CAP_NET_BIND_SERVICE."
    fi
  else
    info "net.ipv4.ip_unprivileged_port_start not readable."
  fi

  local rpf
  if rpf=$(sysctl_value net.ipv4.conf.all.rp_filter); then
    if [[ "$rpf" == 2 ]]; then
      record_pass "Loose reverse-path filtering (rp_filter = 2) for VPN multi-homing."
    else
      record_warn "rp_filter = $rpf: asymmetric VPN routes may drop packets (Omarchy ships 2)."
    fi
  fi

  local rl
  if rl=$(sysctl_value net.ipv4.conf.all.route_localnet) && [[ "$rl" == 1 ]]; then
    record_warn "net.ipv4.conf.all.route_localnet = 1: loopback addresses become routable."
  fi
}

# -----------------------------------------------------------------------------
# 2. DNS
# -----------------------------------------------------------------------------
audit_dns() {
  header "2. DNS"
  local rc="$R/etc/resolv.conf" ns
  if [[ -L "$rc" ]]; then
    info "/etc/resolv.conf is a symlink to $(readlink "$rc") (opt-in resolver)."
  elif [[ -f "$rc" ]]; then
    if grep -qi 'generated by WSL' "$rc"; then
      record_pass "/etc/resolv.conf is generated by WSL (generateResolvConf = true)."
    elif grep -q '^# Managed by omarchy-dns-sync' "$rc"; then
      record_pass "/etc/resolv.conf was repaired by omarchy-dns-sync (direct mode)."
    else
      info "/etc/resolv.conf is a custom file."
    fi
    ns=$(count_matches '^nameserver[[:space:]]+[0-9A-Fa-f:.]+' "$rc")
    if (( ns > 0 )); then
      record_pass "/etc/resolv.conf lists $ns nameserver(s)."
    else
      record_fail "/etc/resolv.conf has no nameserver. Run: sudo omarchy-dns-sync"
    fi
    if grep -Eq '^options.*\brotate\b' "$rc"; then
      record_warn "resolv.conf uses 'options rotate' (split-horizon names may fail intermittently)."
    fi
  else
    record_fail "/etc/resolv.conf does not exist. Run: sudo omarchy-dns-sync"
  fi

  if have systemctl; then
    if systemctl is-active --quiet systemd-resolved 2>/dev/null; then
      info "systemd-resolved is active (opt-in; the image masks it). Make sure /etc/resolv.conf points at it."
    else
      record_pass "systemd-resolved is not running (expected: WSL provides resolv.conf)."
    fi
  fi

  local d ok=0
  for d in archlinux.org github.com cloudflare.com; do
    if timeout 5 getent ahosts "$d" >/dev/null 2>&1; then ok=1; break; fi
  done
  if (( ok )); then
    record_pass "Public names resolve."
  else
    record_fail "DNS resolution failed for archlinux.org, github.com and cloudflare.com."
  fi
}

# -----------------------------------------------------------------------------
# 3. Proxy & TLS
# -----------------------------------------------------------------------------
audit_proxy_and_tls() {
  header "3. Proxy & TLS trust"
  local var active=""
  for var in https_proxy HTTPS_PROXY http_proxy HTTP_PROXY all_proxy; do
    if [[ -n "${!var:-}" ]]; then active="${!var}"; break; fi
  done
  if [[ -n "$active" ]]; then
    info "Proxy in use: $active"
  else
    info "No proxy variables set."
  fi

  local out
  if have curl; then
    out=$(curl -sS -I -m 8 https://archlinux.org 2>&1) || true
    if [[ "$out" == *HTTP/* ]]; then
      record_pass "HTTPS to archlinux.org works (certificate chain trusted)."
    elif [[ "$out" == *certificate* || "$out" == *SSL* ]]; then
      record_fail "TLS verification failed: likely an inspecting proxy whose root CA Linux does not trust. Run: sudo omarchy-ca-sync"
    else
      record_warn "HTTPS probe failed without a TLS error (offline, blocked or timed out)."
    fi
  else
    info "curl not installed; HTTPS probe not run."
  fi
}

# -----------------------------------------------------------------------------
# 4. pacman
# -----------------------------------------------------------------------------
audit_pacman() {
  header "4. pacman"
  local conf="$R/etc/pacman.conf" ml="$R/etc/pacman.d/mirrorlist" n
  if [[ -f "$conf" ]]; then
    if grep -Eq '^[[:space:]]*DisableSandbox' "$conf"; then
      record_warn "pacman download sandbox disabled (DisableSandbox); the image keeps it on."
    else
      record_pass "pacman download sandbox enabled$(grep -Eq '^[[:space:]]*DownloadUser' "$conf" && echo ' (DownloadUser set)')."
    fi
    if grep -Eq '^[[:space:]]*XferCommand' "$conf"; then
      if grep -Eq '^[[:space:]]*XferCommand.*--connect-timeout' "$conf"; then
        record_pass "XferCommand sets a connect timeout."
      else
        record_warn "XferCommand has no --connect-timeout; a black-holed mirror can stall downloads."
      fi
    else
      record_pass "pacman uses its built-in downloader (no XferCommand)."
    fi
  else
    record_fail "$conf not found."
  fi

  if [[ -f "$ml" ]]; then
    n=$(count_matches '^Server[[:space:]]*=[[:space:]]*https?://[^[:space:]]+' "$ml")
    if (( n > 0 )); then
      record_pass "Mirrorlist has $n active server(s)."
    else
      record_fail "Mirrorlist has no usable Server line. Run: sudo omarchy-mirror-sync restore-default"
    fi
    if (( $(count_matches '^Server[[:space:]]*=[[:space:]]*http://' "$ml") > 0 )); then
      record_warn "Mirrorlist contains plain-http servers."
    fi
  else
    record_fail "$ml is missing. Run: sudo omarchy-mirror-sync restore-default"
  fi
}

# -----------------------------------------------------------------------------
# 5. Containers
# -----------------------------------------------------------------------------
audit_containers() {
  header "5. Container engines"
  local dj="$R/etc/docker/daemon.json" cc="$R/etc/containers/containers.conf"
  if [[ -f "$dj" ]]; then
    if grep -q 'default-address-pools' "$dj"; then
      record_pass "Docker uses dedicated address pools (avoids Docker's default bridge subnet colliding with VPN routes)."
    else
      record_warn "Docker has no default-address-pools; its default bridge subnet may collide with VPN or corporate routes."
    fi
    if grep -q '127\.0\.0\.53' "$dj"; then
      record_warn "daemon.json points containers at 127.0.0.53, but systemd-resolved is not running in this image."
    fi
  elif have dockerd; then
    record_warn "dockerd is installed but /etc/docker/daemon.json is missing."
  else
    info "Docker not installed."
  fi
  if have podman; then
    if [[ -f "$cc" ]]; then
      record_pass "Podman containers.conf present."
    else
      record_warn "Podman installed without /etc/containers/containers.conf."
    fi
  else
    info "Podman not installed."
  fi
}

# -----------------------------------------------------------------------------
# 6. Loopback & interop shims
# -----------------------------------------------------------------------------
audit_local() {
  header "6. Loopback & Windows shims"
  if have ping; then
    if ping -c 1 -W 1 127.0.0.1 >/dev/null 2>&1; then
      record_pass "IPv4 loopback answers."
    else
      record_fail "IPv4 loopback (127.0.0.1) does not answer."
    fi
    if ping -c 1 -W 1 ::1 >/dev/null 2>&1; then
      record_pass "IPv6 loopback answers."
    else
      record_warn "IPv6 loopback (::1) does not answer; services bound to ::1 are unreachable."
    fi
  else
    info "ping not installed; loopback probe not run."
  fi
  if [[ -e "$R/usr/lib/omarchy-wsl/bin/powershell.exe" ]]; then
    record_pass "Windows shims installed in /usr/lib/omarchy-wsl/bin."
  else
    record_warn "Windows shims missing. Run as root: /usr/lib/omarchy-wsl/bin/wsl-shims-setup.sh"
  fi
}

run_all_audits() {
  N_PASS=0 N_WARN=0 N_FAIL=0
  audit_wsl_mode
  audit_dns
  audit_proxy_and_tls
  audit_pacman
  audit_containers
  audit_local
  header "Summary"
  printf '  Checks: %d  (pass %s%d%s, warn %s%d%s, fail %s%d%s; INFO lines are not counted)\n' \
    $((N_PASS + N_WARN + N_FAIL)) "$C_GREEN" "$N_PASS" "$C_RESET" "$C_YELLOW" "$N_WARN" "$C_RESET" "$C_RED" "$N_FAIL" "$C_RESET"
  if (( N_FAIL == 0 )); then
    printf '\n%s%sNo failures.%s\n' "$C_GREEN" "$C_BOLD" "$C_RESET"
    return 0
  fi
  printf '\n%s%s%d failure(s). Try: sudo omarchy-netdoctor --repair%s\n' "$C_RED" "$C_BOLD" "$N_FAIL" "$C_RESET"
  return 1
}

# find_sync_tool <name>: PATH first (installed system), then the sibling copy.
find_sync_tool() {
  if command -v "$1" >/dev/null 2>&1; then
    command -v "$1"
  elif [[ -x "$SELF_DIR/$1" ]]; then
    echo "$SELF_DIR/$1"
  else
    return 1
  fi
}

run_repair() {
  local step tool rc
  header "Repair"
  (( EUID == 0 )) || log "Not running as root: the sync tools need root to write /etc (re-run with sudo)."
  for step in "omarchy-dns-sync sync" "omarchy-ca-sync" "omarchy-proxy-sync" "omarchy-mirror-sync rank"; do
    read -r -a argv <<<"$step"
    if ! tool=$(find_sync_tool "${argv[0]}"); then
      log "${argv[0]} not installed; skipped."
      continue
    fi
    log "Running ${step}..."
    rc=0
    timeout 120 "$tool" "${argv[@]:1}" || rc=$?
    if (( rc == 0 )); then log "${argv[0]}: ok"; else log "${argv[0]}: exit $rc"; fi
  done
  log "Repair finished; auditing again."
  run_all_audits
}

usage() {
  cat <<EOF
Usage: $(basename "$0") [audit|check|--repair|-r|--help]

  audit, check   run the network audit (default)
  --repair, -r   run omarchy-dns-sync, omarchy-ca-sync, omarchy-proxy-sync and
                 omarchy-mirror-sync (as root), then audit again
  --help, -h     show this help
EOF
}

case "${1:-audit}" in
  audit|check) run_all_audits ;;
  --repair|--fix-all|-r) run_repair ;;
  --help|-h|help) usage ;;
  *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
esac
