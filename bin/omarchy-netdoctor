#!/usr/bin/env bash
# ==============================================================================
# Omarchy WSL: Adversarial Network & Topology Diagnostic Suite
# /usr/bin/omarchy-netdoctor
# ==============================================================================
# Comprehensive audit and automated self-healing for WSL networking modes,
# DNS tunneling, corporate proxies, VPNs, Docker collisions, and pacman mirrors.
# ==============================================================================

set -euo pipefail

COLOR_RESET="\e[0m"
COLOR_GREEN="\e[32m"
COLOR_YELLOW="\e[33m"
COLOR_RED="\e[31m"
COLOR_CYAN="\e[36m"
COLOR_BOLD="\e[1m"

pass() { echo -e "  [${COLOR_GREEN}PASS${COLOR_RESET}] $*"; }
warn() { echo -e "  [${COLOR_YELLOW}WARN${COLOR_RESET}] $*"; }
fail() { echo -e "  [${COLOR_RED}FAIL${COLOR_RESET}] $*"; }
info() { echo -e "  [${COLOR_CYAN}INFO${COLOR_RESET}] $*"; }
header() { echo -e "\n${COLOR_BOLD}${COLOR_CYAN}=== $* ===${COLOR_RESET}"; }

TOTAL_CHECKS=0
TOTAL_FAILS=0
TOTAL_WARNS=0

check_start() { TOTAL_CHECKS=$((TOTAL_CHECKS + 1)); }
record_fail() { TOTAL_FAILS=$((TOTAL_FAILS + 1)); fail "$*"; }
record_warn() { TOTAL_WARNS=$((TOTAL_WARNS + 1)); warn "$*"; }
record_pass() { pass "$*"; }

# -----------------------------------------------------------------------------
# 1. Host WSL Virtualization & Networking Mode Audit
# -----------------------------------------------------------------------------
audit_wsl_mode() {
  header "1. WSL Hypervisor & Networking Topology"

  check_start
  if [[ -f "/proc/sys/fs/binfmt_misc/WSLInterop" || -d "/run/WSL" ]]; then
    record_pass "WSL environment detected."
  else
    record_warn "Not running inside standard WSL environment (running on Linux host/container)."
  fi

  check_start
  # Detect mirrored vs NAT mode
  # In mirrored mode, loopback or eth0 has host interfaces, or /sys/class/net shows mirrored devices
  local has_mirrored=0
  if ip link show 2>/dev/null | grep -qi "loopback0\|Wi-Fi\|Ethernet"; then
    has_mirrored=1
  elif ip -4 addr show 2>/dev/null | grep -q "10.255.255.254"; then
    has_mirrored=1
  fi

  if [[ $has_mirrored -eq 1 ]]; then
    record_pass "Windows 11 Mirrored Networking mode active (Hyper-V VFP)."
  else
    local default_gw
    default_gw=$(ip route show default 2>/dev/null | awk '{print $3}' | head -n 1 || true)
    if [[ "$default_gw" =~ ^172\. ]]; then
      record_warn "WSL running in traditional NAT mode (Gateway: $default_gw)."
      info "Mirrored networking recommended for VPN resilience on Windows 11 Build 22621+."
    else
      record_pass "Network routing active (Default Gateway: ${default_gw:-none})."
    fi
  fi

  # Check unprivileged port sysctl
  check_start
  local unpriv_port
  unpriv_port=$(sysctl -n net.ipv4.ip_unprivileged_port_start 2>/dev/null || echo "1024")
  if [[ "$unpriv_port" -eq 0 ]]; then
    record_pass "Unprivileged port binding enabled (net.ipv4.ip_unprivileged_port_start = 0)."
  else
    record_warn "Privileged ports restricted (< $unpriv_port). Non-root users cannot bind port 80/443 without sudo."
  fi

  # Check reverse path filter (RPF)
  check_start
  local rpf
  rpf=$(sysctl -n net.ipv4.conf.all.rp_filter 2>/dev/null || echo "1")
  if [[ "$rpf" -eq 2 ]]; then
    record_pass "Loose Reverse Path Filtering active (rp_filter = 2) for VPN resilience."
  else
    record_warn "Strict or default rp_filter ($rpf). Asymmetric VPN routes may cause packet drops."
  fi
}

# -----------------------------------------------------------------------------
# 2. DNS Resolution & systemd-resolved Audit
# -----------------------------------------------------------------------------
audit_dns_topology() {
  header "2. DNS Subsystem & Resolver Topology"

  check_start
  local resolv_conf="/etc/resolv.conf"
  if [[ -L "$resolv_conf" ]]; then
    local target
    target=$(readlink -f "$resolv_conf")
    record_pass "/etc/resolv.conf is a symlink to: $target"
  elif [[ -f "$resolv_conf" ]]; then
    if grep -qi "automatically generated by WSL" "$resolv_conf"; then
      record_pass "/etc/resolv.conf is generated by WSL init."
    else
      info "/etc/resolv.conf is a static or custom configuration file."
    fi
  else
    record_fail "/etc/resolv.conf does not exist!"
  fi

  # Check systemd-resolved status
  check_start
  if command -v systemctl >/dev/null 2>&1; then
    if systemctl is-active --quiet systemd-resolved 2>/dev/null; then
      record_pass "systemd-resolved.service is running."
      
      # Check DNSSEC setting
      if [[ -f "/etc/systemd/resolved.conf.d/10-omarchy-wsl.conf" ]]; then
        if grep -q "DNSSEC=no" "/etc/systemd/resolved.conf.d/10-omarchy-wsl.conf"; then
          record_pass "DNSSEC disabled in resolved drop-in (prevents corporate proxy SERVFAIL)."
        else
          record_warn "DNSSEC not explicitly disabled. May fail behind enterprise MITM proxies."
        fi
      fi
    else
      record_warn "systemd-resolved.service is not active."
    fi
  else
    info "systemctl not available; skipping systemd-resolved check."
  fi

  # Functional DNS test
  check_start
  local dns_test=0
  for domain in "archlinux.org" "github.com" "cloudflare.com"; do
    if getent ahostsv4 "$domain" >/dev/null 2>&1; then
      dns_test=1
      break
    fi
  done

  if [[ $dns_test -eq 1 ]]; then
    record_pass "DNS resolution is functional across public endpoints."
  else
    record_fail "CRITICAL: DNS resolution completely failed! Unable to resolve public hosts."
  fi
}

# -----------------------------------------------------------------------------
# 3. Corporate Proxy & TLS Certificate Audit
# -----------------------------------------------------------------------------
audit_proxy_and_tls() {
  header "3. Corporate Proxy & TLS Trust Verification"

  check_start
  local proxy_active=0
  for var in http_proxy https_proxy HTTP_PROXY HTTPS_PROXY; do
    if [[ -n "${!var:-}" ]]; then
      proxy_active=1
      break
    fi
  done

  if [[ $proxy_active -eq 1 ]]; then
    record_pass "Corporate HTTP proxy variables active (${http_proxy:-${https_proxy:-none}})."
  else
    info "No HTTP proxy environment variables configured."
  fi

  # Probe HTTPS connectivity and verify certificate chain
  check_start
  local curl_out
  curl_out=$(curl -s -f -I -m 5 https://archlinux.org 2>&1 || true)
  if [[ "$curl_out" =~ "HTTP/" ]]; then
    record_pass "HTTPS handshake and certificate verification successful."
  elif [[ "$curl_out" =~ "certificate" || "$curl_out" =~ "SSL" ]]; then
    record_fail "TLS Certificate verification failed: Corporate MITM proxy detected without trusted root CA!"
    info "Run 'omarchy-ca-sync' to import Windows Enterprise Root CAs."
  else
    record_warn "HTTPS probe encountered non-fatal timeout or connection refusal."
  fi
}

# -----------------------------------------------------------------------------
# 4. Pacman Mirror & Download Resilience Audit
# -----------------------------------------------------------------------------
audit_pacman_resilience() {
  header "4. Pacman & Package Repository Resilience"

  check_start
  local pacman_conf="/etc/pacman.conf"
  if [[ -f "$pacman_conf" ]]; then
    if grep -q "^DisableSandbox" "$pacman_conf" 2>/dev/null; then
      record_pass "Pacman sandbox disabled (DisableSandbox) for WSL container stability."
    else
      record_warn "DisableSandbox missing from $pacman_conf. May fail under seccomp."
    fi

    if grep -q "^XferCommand.*connect-timeout" "$pacman_conf" 2>/dev/null; then
      record_pass "Pacman XferCommand configured with aggressive connection timeout."
    else
      record_warn "Pacman XferCommand lacks connect-timeout. Dead mirrors may hang for 5 minutes."
    fi
  else
    record_fail "Pacman configuration file ($pacman_conf) not found!"
  fi

  check_start
  local mirrorlist="/etc/pacman.d/mirrorlist"
  if [[ -f "$mirrorlist" ]]; then
    local server_count
    server_count=$(grep -c "^Server" "$mirrorlist" 2>/dev/null || echo "0")
    if [[ "$server_count" -gt 0 ]]; then
      record_pass "Mirrorlist contains $server_count active mirror servers."
    else
      record_fail "CRITICAL: /etc/pacman.d/mirrorlist has 0 active Server entries! Package updates will fail."
    fi
  else
    record_fail "/etc/pacman.d/mirrorlist missing!"
  fi
}

# -----------------------------------------------------------------------------
# 5. Container Engine Coexistence (Docker & Podman)
# -----------------------------------------------------------------------------
audit_container_bridges() {
  header "5. Container Engine Coexistence (Docker & Podman)"

  check_start
  if command -v dockerd >/dev/null 2>&1 || [[ -f "/etc/docker/daemon.json" ]]; then
    if [[ -f "/etc/docker/daemon.json" ]]; then
      if grep -q "default-address-pools" "/etc/docker/daemon.json"; then
        record_pass "Docker configured with isolated address pools (prevents corporate subnet collision)."
      else
        record_warn "Docker daemon.json lacks default-address-pools. Default 172.17.0.0/16 may collide with VPNs."
      fi

      if grep -q '"mtu": 1420' "/etc/docker/daemon.json"; then
        record_pass "Docker MTU clamped to 1420 for VPN tunnel packet compatibility."
      else
        record_warn "Docker MTU not clamped. Packets larger than 1420 may be dropped on VPN tunnels."
      fi
    else
      record_warn "Docker installed but /etc/docker/daemon.json not found."
    fi
  else
    info "Docker daemon not installed; skipping Docker check."
  fi

  check_start
  if command -v podman >/dev/null 2>&1; then
    if [[ -f "/etc/containers/containers.conf" ]]; then
      record_pass "Podman containers.conf found."
    else
      record_warn "Podman installed but hardened containers.conf not configured."
    fi
  else
    info "Podman not installed; skipping Podman check."
  fi
}

# -----------------------------------------------------------------------------
# 6. Localhost Dual-Stack & Host Port Interop
# -----------------------------------------------------------------------------
audit_localhost_interop() {
  header "6. Localhost Dual-Stack & Host Interop"

  check_start
  # Verify IPv4 loopback
  if ping -c 1 -W 1 127.0.0.1 >/dev/null 2>&1; then
    record_pass "IPv4 localhost (127.0.0.1) is operational."
  else
    record_fail "IPv4 localhost is down!"
  fi

  # Verify IPv6 loopback
  check_start
  if ping -c 1 -W 1 ::1 >/dev/null 2>&1; then
    record_pass "IPv6 localhost (::1) is operational."
  else
    record_warn "IPv6 localhost (::1) is not responding. Dual-stack apps may fail to bind ::1."
  fi

  # Check Windows interop shims
  check_start
  if [[ -d "/usr/lib/omarchy-wsl/bin" && -x "/usr/lib/omarchy-wsl/bin/powershell.exe" ]]; then
    record_pass "Windows interop shims installed in /usr/lib/omarchy-wsl/bin."
  else
    record_warn "Windows interop shims not installed. Run 'wsl-shims-setup.sh' to enable."
  fi
}

# -----------------------------------------------------------------------------
# Automated Repair Routine
# -----------------------------------------------------------------------------
run_repair() {
  header "Initiating Automated Network & DNS Self-Healing"

  log "1. Synchronizing Dynamic DNS & Resolver..."
  if command -v omarchy-dns-sync >/dev/null 2>&1; then
    omarchy-dns-sync sync || true
  elif [[ -x "$(dirname "$0")/omarchy-dns-sync" ]]; then
    "$(dirname "$0")/omarchy-dns-sync" sync || true
  fi

  log "2. Synchronizing Windows Enterprise Root CAs..."
  if command -v omarchy-ca-sync >/dev/null 2>&1; then
    omarchy-ca-sync || true
  elif [[ -x "$(dirname "$0")/omarchy-ca-sync" ]]; then
    "$(dirname "$0")/omarchy-ca-sync" || true
  fi

  log "3. Synchronizing Windows Host Proxy..."
  if command -v omarchy-proxy-sync >/dev/null 2>&1; then
    omarchy-proxy-sync || true
  elif [[ -x "$(dirname "$0")/omarchy-proxy-sync" ]]; then
    "$(dirname "$0")/omarchy-proxy-sync" || true
  fi

  log "4. Optimizing Pacman Mirrorlist..."
  if command -v omarchy-mirror-sync >/dev/null 2>&1; then
    omarchy-mirror-sync rank || true
  elif [[ -x "$(dirname "$0")/omarchy-mirror-sync" ]]; then
    "$(dirname "$0")/omarchy-mirror-sync" rank || true
  fi

  log "Self-healing completed. Re-running diagnostic audit..."
  run_all_audits
}

run_all_audits() {
  TOTAL_CHECKS=0
  TOTAL_FAILS=0
  TOTAL_WARNS=0

  audit_wsl_mode
  audit_dns_topology
  audit_proxy_and_tls
  audit_pacman_resilience
  audit_container_bridges
  audit_localhost_interop

  header "Audit Summary"
  echo -e "  Total Checks: ${TOTAL_CHECKS}"
  echo -e "  Passed:       ${COLOR_GREEN}$((TOTAL_CHECKS - TOTAL_FAILS - TOTAL_WARNS))${COLOR_RESET}"
  echo -e "  Warnings:     ${COLOR_YELLOW}${TOTAL_WARNS}${COLOR_RESET}"
  echo -e "  Failures:     ${COLOR_RED}${TOTAL_FAILS}${COLOR_RESET}"

  if [[ $TOTAL_FAILS -eq 0 ]]; then
    echo -e "\n${COLOR_GREEN}${COLOR_BOLD}[SUCCESS] Omarchy WSL network subsystem is healthy!${COLOR_RESET}\n"
    return 0
  else
    echo -e "\n${COLOR_RED}${COLOR_BOLD}[ACTION REQUIRED] Encountered $TOTAL_FAILS failure(s). Run 'omarchy-netdoctor --repair' to fix.${COLOR_RESET}\n"
    return 1
  fi
}

# -----------------------------------------------------------------------------
# Entry Point
# -----------------------------------------------------------------------------
case "${1:-audit}" in
  audit|check)
    run_all_audits
    ;;
  --repair|--fix-all|-r)
    run_repair
    ;;
  --help|-h)
    cat << EOF
Usage: $(basename "$0") [OPTIONS]

Options:
  audit, check        Run full adversarial network diagnostic audit (default)
  --repair, -r        Automatically repair and synchronize DNS, CAs, and mirrors
  --help, -h          Show this help message
EOF
    ;;
  *)
    echo "Unknown option: $1" >&2
    exit 1
    ;;
esac
