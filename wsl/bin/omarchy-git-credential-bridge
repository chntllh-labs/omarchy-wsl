#!/usr/bin/env bash
# ==============================================================================
# Omarchy WSL: Git Credential Bridge (Windows GCM -> gh CLI fallback)
# /usr/lib/omarchy-wsl/bin/omarchy-git-credential-bridge
# ==============================================================================
# A git credential helper that shares the Windows host's Git Credential Manager
# vault (GitHub / Azure Repos / Bitbucket OAuth, Windows Credential Manager)
# with WSL, and falls back to `gh auth git-credential` when GCM is absent.
#
#   git -> omarchy-git-credential-bridge get
#            1. git-credential-manager.exe (Windows, via interop)
#            2. gh auth git-credential     (Linux)
#            3. nothing -> git continues to its next helper / prompt
#
# Why a bridge instead of pointing credential.helper at the .exe directly:
#   * the GCM path moves between Git for Windows builds (mingw64 -> ucrt64 in
#     2.56, clangarm64 on ARM64, standalone installs) — resolved per call;
#   * uninstalling Git for Windows must not break every `git pull` in WSL;
#   * GIT_TERMINAL_PROMPT=0 is translated to GCM_INTERACTIVE=never so CI and
#     agents never block on a Windows OAuth dialog;
#   * output is CR-stripped and bounded by a timeout.
# ==============================================================================

set -euo pipefail

_self="$(readlink -f "${BASH_SOURCE[0]}")"
for _lib in "${OMARCHY_WSL_LIB:-}" "${_self%/*}/../lib/omarchy-wsl-interop.sh" "${_self%/*}/../../lib/omarchy-wsl-interop.sh" /usr/lib/omarchy-wsl/interop.sh; do
  # shellcheck source=SCRIPTDIR/../../lib/omarchy-wsl-interop.sh
  [[ -n "$_lib" && -r "$_lib" ]] && { source "$_lib"; break; }
done
declare -F omw_is_wsl >/dev/null || { echo "omarchy-git-credential-bridge: interop library not found" >&2; exit 1; }
OMW_TAG="omarchy-git-credential-bridge"

HELPER_PATH="${OMARCHY_GIT_CREDENTIAL_HELPER_PATH:-/usr/lib/omarchy-wsl/bin/omarchy-git-credential-bridge}"
BACKUP_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/git-credential-helpers.backup"
ORDER="${OMARCHY_GIT_CREDENTIAL_ORDER:-gcm gh}"
# OAuth device/browser flows legitimately take minutes.
CRED_TIMEOUT="${OMARCHY_GIT_CREDENTIAL_TIMEOUT:-300}"

usage() {
  cat <<'EOF'
Usage: omarchy-git-credential-bridge <command>

Git credential protocol (called by git):
  get | store | erase

Management:
  install [--dry-run]   Configure ~/.gitconfig to use this bridge (backs up old helpers)
  uninstall             Restore the helpers saved by install
  status                Show which backends are available
  gh-token              Print the github.com token held by Windows GCM
  exec-gh -- ARGS       Run gh with GH_TOKEN borrowed from GCM (no `gh auth login`)

Environment:
  OMARCHY_GIT_CREDENTIAL_ORDER    Backend order (default: "gcm gh")
  OMARCHY_GCM                     Explicit path to git-credential-manager.exe
  OMARCHY_GIT_CREDENTIAL_TIMEOUT  Seconds to wait for a backend (default: 300)
EOF
}

# -----------------------------------------------------------------------------
# Backend discovery
# -----------------------------------------------------------------------------
find_gcm() {
  if [[ -n "${OMARCHY_GCM:-}" ]]; then
    [[ -x "$OMARCHY_GCM" ]] && { echo "$OMARCHY_GCM"; return 0; }
    return 1
  fi
  omw_is_wsl && omw_interop_enabled || return 1
  local cached root profile="" up c exe
  if cached=$(omw_cache_get gcm-path 86400) && [[ -x "$cached" ]]; then
    echo "$cached"
    return 0
  fi
  root=$(omw_mount_root)
  if up=$(omw_win_env USERPROFILE 2>/dev/null); then
    profile=$(omw_win_to_unix "$up" 2>/dev/null || true)
  fi
  local -a dirs=(
    "$root/c/Program Files/Git/ucrt64/bin"                 # Git for Windows >= 2.56 (x64)
    "$root/c/Program Files/Git/mingw64/bin"                # Git for Windows <= 2.55 (x64)
    "$root/c/Program Files/Git/clangarm64/bin"             # Git for Windows ARM64 (Snapdragon)
    "$root/c/Program Files/Git/mingw64/libexec/git-core"   # legacy layouts
    "$root/c/Program Files/Git Credential Manager"         # standalone (x64/arm64)
    "$root/c/Program Files (x86)/Git Credential Manager"   # standalone (x86)
  )
  [[ -n "$profile" ]] && dirs+=("$profile/AppData/Local/Programs/Git Credential Manager")
  for c in "${dirs[@]}"; do
    for exe in git-credential-manager.exe git-credential-manager-core.exe; do
      if [[ -f "$c/$exe" && -x "$c/$exe" ]]; then
        omw_cache_put gcm-path "$c/$exe"
        echo "$c/$exe"
        return 0
      fi
    done
  done
  return 1
}

have_gh() { omw_have gh; }

# -----------------------------------------------------------------------------
# Backend invocation
# -----------------------------------------------------------------------------
run_gcm() {
  local action="$1" gcm
  gcm=$(find_gcm) || return 1
  local wslenv="${WSLENV:-}"
  # Share GIT_EXEC_PATH (translated) so standalone GCM can locate git, and
  # disable interactive prompts when git itself was told not to prompt.
  local gcm_interactive="${GCM_INTERACTIVE:-}"
  if [[ "${GIT_TERMINAL_PROMPT:-1}" == "0" ]]; then
    gcm_interactive="never"
  fi
  wslenv="${wslenv:+${wslenv}:}GIT_EXEC_PATH/wp"
  [[ -n "$gcm_interactive" ]] && wslenv="${wslenv}:GCM_INTERACTIVE"
  (
    cd "$(omw_system_root 2>/dev/null || echo /)" 2>/dev/null || true
    export WSLENV="$wslenv"
    export GIT_EXEC_PATH="${GIT_EXEC_PATH:-$(git --exec-path 2>/dev/null || echo /usr/lib/git-core)}"
    [[ -n "$gcm_interactive" ]] && export GCM_INTERACTIVE="$gcm_interactive"
    timeout --kill-after=5 "$CRED_TIMEOUT" "$gcm" "$action"
  ) | tr -d '\r'
  return "${PIPESTATUS[0]}"
}

run_gh() {
  local action="$1"
  have_gh || return 1
  # gh implements only `get` (store/erase are deliberate no-ops) for https.
  timeout --kill-after=5 "$CRED_TIMEOUT" gh auth git-credential "$action" | tr -d '\r'
  return "${PIPESTATUS[0]}"
}

# Validate credential-protocol input: key=value lines (keys may carry [] as in
# wwwauth[] / capability[]), no NUL, bounded size.
read_request() {
  local req
  req=$(head -c 65536)
  if [[ -n "$req" ]] && ! grep -qvE '^([A-Za-z_][][A-Za-z0-9_.-]*=.*)?$' <<<"$req"; then
    printf '%s\n' "$req"
    return 0
  fi
  [[ -z "$req" ]] && return 0
  omw_err "Malformed credential request; ignoring."
  return 1
}

cred_get() {
  local req out backend
  req=$(read_request) || return 0
  for backend in $ORDER; do
    case "$backend" in
      gcm) out=$(printf '%s\n\n' "$req" | run_gcm get 2>/dev/null) || out="" ;;
      gh)  out=$(printf '%s\n\n' "$req" | run_gh get 2>/dev/null) || out="" ;;
      *) continue ;;
    esac
    if grep -q '^password=' <<<"$out"; then
      printf '%s\n' "$out"
      return 0
    fi
  done
  return 0
}

cred_forward() {
  local action="$1" req
  req=$(read_request) || return 0
  # Only GCM persists credentials; forwarding store/erase keeps its vault in
  # sync (e.g. erase after a revoked token) without touching gh.
  if [[ " $ORDER " == *" gcm "* ]]; then
    printf '%s\n\n' "$req" | run_gcm "$action" >/dev/null 2>&1 || true
  fi
  return 0
}

# -----------------------------------------------------------------------------
# Management commands
# -----------------------------------------------------------------------------
cmd_install() {
  local dry=0
  [[ "${1:-}" == "--dry-run" ]] && dry=1
  local -a existing=()
  mapfile -t existing < <(git config --global --get-all credential.helper 2>/dev/null || true)
  local -a plan=(
    "git config --global --unset-all credential.helper"
    "git config --global --add credential.helper ''"
    "git config --global --add credential.helper $HELPER_PATH"
    "git config --global credential.https://dev.azure.com.useHttpPath true"
  )
  if (( dry )); then
    printf '%s\n' "${plan[@]}"
    return 0
  fi
  mkdir -p "$(dirname "$BACKUP_FILE")"
  if [[ ! -f "$BACKUP_FILE" ]]; then
    printf '%s\n' "${existing[@]+"${existing[@]}"}" >"$BACKUP_FILE"
  fi
  git config --global --unset-all credential.helper 2>/dev/null || true
  # An empty value resets helpers inherited from /etc/gitconfig.
  git config --global --add credential.helper ''
  git config --global --add credential.helper "$HELPER_PATH"
  git config --global credential.https://dev.azure.com.useHttpPath true
  omw_log "Installed. Previous helpers saved to $BACKUP_FILE"
  cmd_status
}

cmd_uninstall() {
  git config --global --unset-all credential.helper 2>/dev/null || true
  if [[ -f "$BACKUP_FILE" ]]; then
    local h
    while IFS= read -r h; do
      [[ -n "$h" ]] && git config --global --add credential.helper "$h"
    done <"$BACKUP_FILE"
    rm -f -- "$BACKUP_FILE"
  fi
  omw_log "Uninstalled; previous helpers restored."
}

cmd_status() {
  local gcm
  if gcm=$(find_gcm 2>/dev/null); then
    echo "gcm:    $gcm"
  else
    echo "gcm:    not found"
  fi
  if have_gh; then
    if gh auth status >/dev/null 2>&1; then echo "gh:     authenticated"; else echo "gh:     installed, not logged in"; fi
  else
    echo "gh:     not installed"
  fi
  echo "order:  $ORDER"
  echo "helper: $(git config --global --get-all credential.helper 2>/dev/null | paste -sd' ' - || true)"
}

gcm_github_token() {
  local out
  out=$(printf 'protocol=https\nhost=github.com\n\n' | run_gcm get 2>/dev/null) || return 1
  sed -n 's/^password=//p' <<<"$out" | head -n 1
}

cmd_gh_token() {
  local token
  token=$(gcm_github_token) || true
  [[ -n "$token" ]] || omw_die "Windows GCM holds no github.com credential (run any git fetch from Windows first)."
  printf '%s\n' "$token"
}

# `gh auth login --with-token` rejects GCM tokens (scopes repo,gist,workflow
# lack read:org), but GH_TOKEN is not scope-validated. Borrow it per process
# instead of persisting a copy in ~/.config/gh/hosts.yml.
cmd_exec_gh() {
  [[ "${1:-}" == "--" ]] && shift
  have_gh || omw_die "gh is not installed."
  if [[ -n "${GH_TOKEN:-}${GITHUB_TOKEN:-}" ]] || gh auth status >/dev/null 2>&1; then
    exec gh "$@"
  fi
  local token
  token=$(gcm_github_token) || true
  [[ -n "$token" ]] || exec gh "$@"
  GH_TOKEN="$token" exec gh "$@"
}

CMD="${1:-}"
[[ -n "$CMD" ]] || { usage >&2; exit 2; }
shift
case "$CMD" in
  get) cred_get ;;
  store|erase) cred_forward "$CMD" ;;
  install) cmd_install "$@" ;;
  uninstall) cmd_uninstall ;;
  status) cmd_status ;;
  gh-token) cmd_gh_token ;;
  exec-gh) cmd_exec_gh "$@" ;;
  -h|--help|help) usage ;;
  # Unknown actions must be ignored per gitcredentials(7).
  *) exit 0 ;;
esac
