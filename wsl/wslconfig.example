# %USERPROFILE%\.wslconfig
#
# Production WSL2 Virtualization Profile for Omarchy-WSL
# Tuned for high-core ARM64 (Snapdragon Oryon 18c) and x86_64 hosts.
#
# Place this file in C:\Users\<YourUser>\.wslconfig and apply via:
#   wsl --shutdown
#

[wsl2]
# Core Compute & Memory Governance
# Generated adaptively by tools/generate-wslconfig.ps1
processors = 18
memory = 48GB
swap = 16GB
nestedVirtualization = true
localhostForwarding = true
guiApplications = true
vmIdleTimeout = 60000

# High-Performance Mirrored Networking Stack
networkingMode = mirrored
dnsTunneling = true
autoProxy = true
hostAddressLoopback = true
firewall = true
ignoredPorts = 5353,5355

[experimental]
# Automatic gradual memory reclamation when Linux is idle.
# 'gradual' releases cached memory over 30 min of idle without
# purging hot working sets, avoiding the cold-cache disk thrashing of 'dropCache'.
autoMemoryReclaim = gradual

# Storage Integrity:
# DO NOT enable sparseVhd=true on mission-critical distros!
# Microsoft gated sparseVhd behind --allow-unsafe in WSL 2.5.6+ due to severe ext4
# superblock and journal corruption from NTFS sparse hole-punching races.
sparseVhd = false
