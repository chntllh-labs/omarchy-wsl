#!/bin/bash
# /usr/lib/omarchy-wsl/apply-etc-overrides
#
# Copies files that other packages own into place: /etc/os-release (owned by
# filesystem as a symlink to /usr/lib/os-release) and /etc/skel/.bashrc (owned
# by bash). Upstream's omarchy-settings uses the same etc-overrides pattern.
# Run by omarchy-wsl.install and, for os-release, by the libalpm hook after any
# transaction that reinstalls filesystem, so the WSL branding survives upgrades.
# /usr/lib/os-release stays Arch for tools that read it directly.

set -euo pipefail

root="${OMARCHY_ROOT:-}"
overrides="$root/usr/share/omarchy-wsl/etc-overrides"

install_copy() {
  local src="$1" dest="$2"
  [[ -f $src ]] || return 0
  if [[ -L $dest || ! -f $dest ]] || ! cmp -s "$src" "$dest"; then
    install -D -m 0644 "$src" "$dest.omarchy-new"
    mv -f "$dest.omarchy-new" "$dest"
  fi
}

install_copy "$overrides/os-release" "$root/etc/os-release"
install_copy "$overrides/dot.bashrc" "$root/etc/skel/.bashrc"
