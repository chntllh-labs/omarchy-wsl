# Omarchy-WSL build slice.
# Installed twice from the same file:
#   /etc/systemd/system/build.slice      system manager (root builds)
#   /usr/lib/systemd/user/build.slice    user manager (omarchy-build runs
#                                        `systemd-run --user --scope --slice=build.slice`)
# Every key below is a [Slice] resource-control directive accepted by
# `systemd-analyze verify` (systemd.resource-control(5)).
[Unit]
Description=Omarchy-WSL build and compilation slice
Documentation=https://github.com/chntllh-labs/omarchy-wsl
Before=slices.target

[Slice]
# CPU and block-I/O weights are relative to sibling units of the same manager
# (default weight 100). 20 means a saturating build gets about 1/6 of the
# contended CPU next to one default-weight sibling such as app.slice, so
# editors and shells in that manager stay responsive. IOWeight only takes
# effect with a weight-aware I/O scheduler (BFQ or io.cost).
CPUWeight=20
IOWeight=20

# Soft ceiling: above 85% of physical memory the kernel throttles and reclaims
# inside this slice instead of letting it push the whole VM into swap.
MemoryHigh=85%

# systemd-oomd (when systemd-oomd.service is enabled) kills the build cgroup
# under the highest memory pressure once pressure stays above the limit for
# DefaultMemoryPressureDurationSec (see 10-omarchy-oomd.conf).
# The kernel-side "kill the whole build together" behaviour is OOMPolicy=kill,
# which omarchy-build sets on each transient build scope.
ManagedOOMMemoryPressure=kill
ManagedOOMMemoryPressureLimit=60%
