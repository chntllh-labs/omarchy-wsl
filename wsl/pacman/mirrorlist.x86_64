# /etc/pacman.d/mirrorlist for Omarchy on WSL (x86_64). HTTPS only.
#
# Omarchy's stable snapshot of Arch Linux (upstream default/pacman/mirrorlist-stable).
Server = https://stable-mirror.omarchy.org/$repo/os/$arch
# Arch Linux's CDN-backed geo mirror and two large HTTPS mirrors.
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirrors.kernel.org/archlinux/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
