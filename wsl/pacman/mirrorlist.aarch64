# /etc/pacman.d/mirrorlist for Omarchy on WSL (aarch64). HTTPS only.
#
# Omarchy's mirror of Arch Linux ARM: the stable snapshot the [omarchy]
# packages are built against (upstream default/pacman/aarch64/mirrorlist-stable).
Server = https://arm-stable-mirror.omarchy.org/$arch/$repo
# Arch Linux ARM mirrors with valid TLS certificates. os.archlinuxarm.org and
# most regional mirrors fail certificate validation over HTTPS.
Server = https://fl.us.mirror.archlinuxarm.org/$arch/$repo
Server = https://ca.us.mirror.archlinuxarm.org/$arch/$repo
