# CLI tooling Omarchy ships on the desktop, minus everything graphical.
# Installed by build/02-omarchy-repo.sh once [omarchy] is trusted.

# Shell experience
btop
eza
bat
fzf
ripgrep
fd
fastfetch
starship
zoxide
dust
dua-cli
tealdeer
plocate
usage
git-delta
lazygit
github-cli
whois

# Toolchains (gcc/make come with base-devel; mise and uv install the rest per user)
nodejs
npm
uv
python-pip
tree-sitter-cli
lua51
luarocks

# Containers (docker.socket is enabled; the daemon starts on first use)
docker
docker-buildx
docker-compose
lazydocker

# Fonts for WSLg applications and anything that rasterises text inside the
# distro. Windows Terminal renders with Windows-side fonts.
fontconfig
ttf-dejavu
noto-fonts-emoji
