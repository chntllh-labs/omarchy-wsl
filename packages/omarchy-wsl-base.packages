psmisc
file
diffutils
gawk
git
tmux
neovim
jq
gum
perl
python
socat
inotify-tools
pacman-contrib
expac
fakeroot
xdg-utils

# WSLg audio and clipboard (WSLg's PulseAudio server and Wayland compositor)
libpulse
alsa-plugins
wl-clipboard

# omarchy-tenant: isolated guests (systemd-nspawn ships in systemd)
slirp4netns
arch-install-scripts
