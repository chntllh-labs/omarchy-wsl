Windows Registry Editor Version 5.00

; ==============================================================================
; Omarchy WSL: "Open in Omarchy Terminal" Explorer context menu (per-user, HKCU)
; ==============================================================================
; Static variant of tools/register-explorer-context-menu.ps1 for environments
; where scripts are blocked. Requires Windows Terminal and a Windows Terminal
; profile named "Omarchy".
;
; Every verb runs Windows Terminal by the absolute path of its App Execution
; Alias, never a bare wt.exe looked up through the search path:
;
;   "%LOCALAPPDATA%\Microsoft\WindowsApps\wt.exe" -w 0 new-tab -p "Omarchy" -d "%V."
;
; The command values are REG_EXPAND_SZ so Explorer expands %LOCALAPPDATA% for
; the user who clicks. A .reg file can only write REG_EXPAND_SZ as hex(2):
; the UTF-16LE bytes of the line above plus a terminating NUL. The expansion
; leaves "%V." alone (no closing %); Explorer then substitutes the folder.
;
; "%V." instead of "%V": a drive root would otherwise become "C:\" whose \"
; escapes the closing quote (microsoft/terminal#4571). Windows strips the
; trailing dot from every other directory path.
;
; Undo with tools/unregister-explorer-context-menu.reg
; ==============================================================================

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\OmarchyTerminal]
@="Open in Omarchy Terminal"

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\OmarchyTerminal\command]
@=hex(2):22,00,25,00,4c,00,4f,00,43,00,41,00,4c,00,41,00,50,00,50,00,44,00,41,\
  00,54,00,41,00,25,00,5c,00,4d,00,69,00,63,00,72,00,6f,00,73,00,6f,00,66,00,\
  74,00,5c,00,57,00,69,00,6e,00,64,00,6f,00,77,00,73,00,41,00,70,00,70,00,73,\
  00,5c,00,77,00,74,00,2e,00,65,00,78,00,65,00,22,00,20,00,2d,00,77,00,20,00,\
  30,00,20,00,6e,00,65,00,77,00,2d,00,74,00,61,00,62,00,20,00,2d,00,70,00,20,\
  00,22,00,4f,00,6d,00,61,00,72,00,63,00,68,00,79,00,22,00,20,00,2d,00,64,00,\
  20,00,22,00,25,00,56,00,2e,00,22,00,00,00

